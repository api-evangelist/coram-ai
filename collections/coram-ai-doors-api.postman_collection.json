        {
          "id": "82644046-175f-4f5d-8c9c-840816a5c112",
          "name": "Unlock an access control door",
          "request": {
            "name": "Unlock an access control door",
            "description": {
              "content": "Sends a momentary-unlock command to the door's controller board.\nRequires `write:*` scope and an `admin` creator role. The same\npermission checks the in-app unlock flow runs are applied; an API key\nwhose creator no longer has access to the door is rejected.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "access-control",
                "doors",
                ":door_id",
                "unlock"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "door_id",
                  "description": "(Required) ID of the door to unlock"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Auth-Token"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
