    {
      "id": "66c1c5d8-1371-4ec5-a06d-668f99d04996",
      "name": "doors",
      "description": {
        "content": "List access control doors and trigger momentary remote unlocks. The same per-door permission checks the in-app unlock flow runs apply here — a key whose creator cannot unlock a door in the UI cannot unlock it via the API either.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "910d8577-c1e2-4d70-9cf9-5a8366690297",
          "name": "List access control doors",
          "request": {
            "name": "List access control doors",
            "description": {
              "content": "Returns the doors the API key creator can see, with their online\nstatus. Admins see every door in the tenant; lower roles see only\ndoors they have permission to unlock. Use `page` and `limit` to\npaginate; `has_more` on the response signals more pages remain.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "access-control",
                "doors"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "1-indexed page number."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum doors per page (capped at 100)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Auth-Token"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
