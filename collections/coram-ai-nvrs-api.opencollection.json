            "auth": {
              "type": "apikey",
              "key": "X-Auth-Token",
              "value": "{{X-Auth-Token}}",
              "placement": "header"
            }
          },
          "docs": "Run speed test on NVR.\n\nInitiate a speed test on the specified NVR to measure network performance."
        }
      ]
    }
  ],
  "bundled": true
