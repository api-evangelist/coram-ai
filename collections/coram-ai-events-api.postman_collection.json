        {
          "id": "e16fb23a-e1d9-45d7-924a-ba0684a8c047",
          "name": "List access control events",
          "request": {
            "name": "List access control events",
            "description": {
              "content": "Returns events emitted by access control devices: card scans\n(`card_reader_event`), grant/deny decisions (`access_control_event`),\nREX presses (`rex_event`), door-held-open alarms (`door_held_open_event`),\nbattery alerts, and so on. Use the filters to narrow down by door,\ncardholder, event type, or time window. Pagination uses the same\n`page` + `limit` + `has_more` shape as every other developer-API list\nendpoint.\n\nThe per-event `details` object carries event-type-specific data\n(card_id, access_decision_reason, etc.). Treat it defensively: new\nkeys may appear in future event types.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "access-control",
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_time",
                  "value": "<dateTime>",
                  "description": "RFC3339 inclusive lower bound on `timestamp`."
                },
                {
                  "disabled": false,
                  "key": "end_time",
                  "value": "<dateTime>",
                  "description": "RFC3339 inclusive upper bound on `timestamp`."
                },
                {
                  "disabled": false,
                  "key": "door_ids",
                  "value": "<long>",
                  "description": "Repeat to filter to events emitted at specific doors."
                },
                {
                  "disabled": false,
                  "key": "door_ids",
                  "value": "<long>",
                  "description": "Repeat to filter to events emitted at specific doors."
                },
                {
                  "disabled": false,
                  "key": "cardholder_ids",
                  "value": "<long>",
                  "description": "Repeat to filter to events for specific cardholders."
                },
                {
                  "disabled": false,
                  "key": "cardholder_ids",
                  "value": "<long>",
                  "description": "Repeat to filter to events for specific cardholders."
                },
                {
                  "disabled": false,
                  "key": "event_types",
                  "value": "<string>",
                  "description": "Repeat to filter to a subset of event types."
                },
                {
                  "disabled": false,
                  "key": "event_types",
                  "value": "<string>",
                  "description": "Repeat to filter to a subset of event types."
                },
                {
                  "disabled": false,
